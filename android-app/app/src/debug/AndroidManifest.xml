<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. The debug server is the developer's machine over plain http
  (http://10.0.2.2:8000 from the emulator), which Android blocks by default.
  A release build keeps the default and talks https only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
