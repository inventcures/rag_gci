<resources>
    <string name="app_name">Palli Sahayak</string>

    <!--
      Role switcher.

      The wording is deliberately framing rather than protective. ADR 0006 settled
      that the Care Role is not an access boundary: everyone in a household reads one
      record, so a switch that appeared to lock anything would be teaching something
      untrue. Phrases like "Switch account" or "Change profile securely" would
      reintroduce exactly that impression, so none of them appear.
    -->
    <string name="role_switch_explainer">Changing this changes how answers are framed. Everyone in the household reads the same record.</string>
    <string name="role_switch_title">Speaking as</string>

    <!--
      Language.

      Shown once. Re-asking on every launch trains a worker to dismiss the dialog
      without reading it, which is how a wrong language gets set silently and then
      answers in a language the user did not choose.
    -->
    <string name="language_picker_title">Choose your language</string>
    <string name="language_picker_explainer">You can change this later in Settings. Answers will be spoken in the language you pick.</string>

    <!--
      Offline.

      Criterion 3 says the offline state is conveyed by icon and colour as well as
      by text, because a worker who cannot read these words still has to see that
      nothing is live. So every string here is paired with a shape and a colour, and
      none of them is the only carrier of the meaning.

      The two miss reasons are worded differently on purpose. "No bundle yet" means
      sync, and "not one of these questions" means find signal. Telling a worker to do
      the wrong one wastes a visit.
    -->
    <string name="offline_banner_title">Offline</string>
    <string name="offline_banner_body">%1$d questions are available without a connection. Answers may be out of date.</string>

    <!-- Criterion 4: the microphone stays visible and says why it is inert. -->
    <string name="mic_disabled_offline">Voice needs a connection</string>

    <!-- Criterion 7: a miss explains itself instead of going quiet. -->
    <string name="offline_miss_no_bundle">No offline questions have been downloaded yet. Connect once to download them.</string>
    <string name="offline_miss_not_in_bundle">That question is not one of the pre-answered offline questions. It needs a connection.</string>

    <!--
      Answer kinds.

      These words reinforce a colour and a shape. They are never the only thing
      distinguishing a refusal from advice, because the reason to distinguish them is
      that someone may not be able to read them.
    -->
    <string name="kind_answer">Answer</string>
    <string name="kind_redacted">Dose information removed</string>
    <string name="kind_deferral">Deferred to your clinician</string>

    <!-- Criterion 8: a cached answer is never presented as live. -->
    <string name="from_cache_badge">from offline bundle</string>
    <string name="history_empty">Nothing recorded yet. Answers you give will appear here.</string>

    <!--
      Ask screen.

      These three were hardcoded English literals, so a Hindi user saw "Stop speaking"
      in the middle of a Hindi app. Found while auditing for criterion 4, which had
      been ticked on the strength of the offline screens alone. A criterion that is
      ticked from a partial audit is worse than one left open.
    -->
    <string name="ask_prompt">Ask a question</string>
    <string name="stop_speaking">Stop speaking</string>
    <string name="replay_answer">Play the answer again</string>

    <string name="starting_up">Palli Sahayak is starting</string>
    <string name="nav_settings">Settings</string>
    <string name="settings_placeholder">Settings will be available before the study begins.</string>

    <!--
      Found by the lint, not by an audit.

      Six user-facing literals sat in composables. The emergency line is the one that
      matters: a Hindi worker reading an English "call 108" during a crisis is a
      worse outcome than a slower answer.
    -->
    <string name="history_heading">Earlier</string>
    <string name="ask_button_idle">Hold to speak</string>
    <string name="ask_button_listening">Listening, let go to send</string>
    <string name="ask_button_send">Ask</string>
    <string name="ask_button_working">Working</string>
    <string name="evidence_count">From %1$d passages in the handbook</string>
    <string name="cached_notice">Saved answer, not a live one</string>
    <string name="emergency_call_108">This may be an emergency. Call 108 now.</string>
    <string name="offline_banner_a11y">Offline. %1$d questions available</string>
    <string name="active_role_a11y">Active role. %1$s</string>

    <!--
      Release gate (criterion 6). Shown instead of everything else when the server
      does not confirm this release as approved and activated, or cannot be reached.
      Each refusal says why, because a refusal nobody can act on is a support call.
    -->
    <string name="release_refused_drifting_title">This build has changed since it was approved</string>
    <string name="release_refused_drifting_detail">It no longer matches the approved record. The study team needs to look at this before anyone uses it.</string>
    <string name="release_refused_not_approved_title">This version is not approved yet</string>
    <string name="release_refused_not_approved_detail">It has not been signed off by the study team, or the server could not be reached to check. Nothing is lost, and it will open once it is approved.</string>
    <string name="release_refused_not_activated_title">This version is not open yet</string>
    <string name="release_refused_not_activated_detail">It is approved but the study has not started using it yet.</string>
    <string name="release_refused_unusable_title">This version cannot be used</string>
    <string name="release_refused_unusable_detail">The study team has to resolve this before it is used.</string>
    <string name="release_retry">Check again</string>

    <!--
      Registration and sign-in (ticket 22). The phone registers with a Care Role and
      a PIN only: no name and no phone number are asked for or sent.
    -->
    <string name="register_title">Who will use this phone?</string>
    <string name="register_explainer">Pick your role and choose a PIN of 4 to 6 digits. You will need the PIN to sign in again.</string>
    <string name="pin_label">PIN (4 to 6 digits)</string>
    <string name="pin_confirm_label">Type the PIN again</string>
    <string name="register_button">Register</string>
    <string name="pin_invalid">The PIN must be 4 to 6 digits.</string>
    <string name="pin_mismatch">The two PINs are different. Type them again.</string>
    <string name="register_refused">Registration was not accepted. Please try again.</string>
    <string name="sign_in_title">Enter your PIN</string>
    <string name="sign_in_explainer">For your safety the app asks for your PIN again after a few days.</string>
    <string name="sign_in_button">Sign in</string>
    <string name="sign_in_refused">That PIN was not accepted. After 5 wrong tries, wait 15 minutes before trying again.</string>
    <string name="server_unreachable">Could not reach the service. Try again when there is signal.</string>
</resources>
