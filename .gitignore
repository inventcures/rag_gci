.env

# Study source documents (grant application and study protocol PDFs).
# These are large binaries and are governed as study records, not as source.
# They are distributed through the study team's own channel, not via git.
evah_study_docs/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# LaTeX build byproducts. The generated PDF/TEX in out/ are tracked; the
# intermediate files are not.
*.aux
*.log
*.out

# Alternate build output directory (regenerated per run).
out_gemini3.1_ag_23feb2026_0257ist/
# Analytics and supervision artifacts, regenerated per run.
data/analytics/
data/expert_samples/
data/metrics/
data/study/logs/
data/study/drift/

# Voice provider selection and its audit trail.
# Runtime state, not source. Both are recreated on first change, and the audit
# trail is study evidence that should be exported at the end of the study rather
# than committed as it accumulates. A smoke test once wrote two fabricated
# entries into it, which is the reason this is called out.
data/study/voice_provider.json
data/study/voice_provider_audit.jsonl

# MkDocs build output. Generated on every push by .github/workflows/docs.yml.
# Never commit it: it would nest a built copy of the docs inside the repo and
# pull stale pages into every clone.
.mkdocs-site/
